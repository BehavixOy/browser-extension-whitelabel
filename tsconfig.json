{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "target": "ES6",
    "lib": ["DOM", "ES2021"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}